interface ContentPost {
  id: string
  week_start: string
  day_index: number
  day_name: string
  platform: 'Instagram' | 'TikTok' | 'Pauta'
  format: 'Imagen Única' | 'Carrusel' | 'Historia'
  topic: string
  image_description: string
  prompt_chatgpt: string
  caption_idea: string
  hashtags: string
  status: 'pendiente' | 'publicado'
}

