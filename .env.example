# ── Supabase Configuration ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── App URL (Dominio base para códigos QR y enlaces de perfiles) ─────
NEXT_PUBLIC_APP_URL=https://taply-inventory.vercel.app

# ── Seguridad y Acceso Admin (Opcional, default: taply2026) ──────────
ADMIN_PASSWORD=taply2026

# ── Taply Wallet — Google Wallet ─────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_ISSUER_ID=
GOOGLE_CLASS_SUFFIX=taply_loyalty_v1

# ── Taply Wallet — Apple Wallet (Opcional) ───────────────────────────
PKPASS_SERVICE_URL=

# ── Taply Branding ───────────────────────────────────────────────────
TAPLY_LOGO_URL=https://taply.co/logo.png
